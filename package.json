{
  "name": "crossbow-golf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && vitest run -c test/worker/vitest.config.ts",
    "test:unit": "vitest run",
    "test:worker": "vitest run -c test/worker/vitest.config.ts",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply crossbow-golf --local",
    "db:migrate:remote": "wrangler d1 migrations apply crossbow-golf --remote"
  },
  "dependencies": {
    "esri-leaflet": "^3.0.19",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "partysocket": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/esri-leaflet": "^3.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
