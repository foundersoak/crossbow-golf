{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crossbow-golf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROUND_ROOMS", "class_name": "RoundRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoundRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crossbow-golf",
      "database_id": "0612e285-ab1f-4dca-b4a2-2078706944bd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "crossbow-golf-media"
    }
  ]
  // Property coordinates are NEVER put in "vars" here (this file is committed).
  // Locally they go in .dev.vars (gitignored). In production:
  //   wrangler secret put PROPERTY_CENTER_LAT   (and the rest, see README)
}
